/com, **** Done sending components for AM Supports ****
/gst,on,on
fini
*get,_numnode,node,0,count
*get,_numelem,elem,0,count
*get, _MAXELEMNUM, elem, 0, NUM, MAX
*get, _MAXNODENUM, node, 0, NUM, MAX
*get, _MAXELEMTYPE, etyp, 0, NUM, MAX
*get, _MAXREALCONST, rcon, 0, NUM, MAX
/go
/wb,load,end               !  done creating loads
/com,--- Number of total nodes = %_numnode%
/com,--- Number of contact elements = 0
/com,--- Number of spring elements = 0
/com,--- Number of bearing elements = 0
/com,--- Number of solid elements = 5988
/com,--- Number of condensed parts = 0
/com,--- Number of total elements = %_numelem%
*get,_wallbsol,active,,time,wall
/com,****************************************************************************
/com,*************************    SOLUTION       ********************************
/com,****************************************************************************
/solu
antype,4                   ! transient analysis
kbc,1                      ! stepped BC's
!eqsl,sparse               ! using sparse solver which is default so no eqsl command needed
cntr,print,1               ! print out contact info and also make no initial contact an error
cncheck,dmp		!	Enable program controlled contact splitting for distributed memory parallel run
rescontrol,,none                 ! Do not keep any restart files
dmpoption,emat,no             ! Don't combine emat file for DANSYS
dmpoption,esav,no             ! Don't combine esav file for DANSYS

/com,*********** Send AM Knockdown Factors ***********
*create,knockdown,ist
/dtyp,kdel

*end
inistate,read,knockdown,ist
/delete,knockdown,ist
! End of Sending AM Knockdown Factors
/com,*********** Send AM Build Options ***********
amtype,pbf          ! Additive Manufacturing process type
ambuild,plate,0.    ! Send top of build plate location
ammat,1,1260.       ! Send melting temperature for build Body
ammat,2,1260.       ! Send melting temperature for support Body
ambuild,layert,1.e-004,3.00000005960464e-004      ! deposition thickness and layer height
ambuild,scan,1.e-004,1000.    ! hatch spacing and laser speed
ambeam,1  ! Send number of heat sources
ambuild,time,10.,1. ! time to reset recoater arm, and the dwell time multiple
*dim,suppsect,,1    ! Send array for support sections
suppsect(1) = 4          ! section value 
sect,4,support,ASEC ! sectype definition for support
secdata,0.5,0.5,0.5,0.5       ! support knockdown factor
amsupport,1,_CMAMSupport,suppsect       ! AMSupport definition
amstep,preheat,120. ! Build Plate Preheat Temperature
! End of Sending AM Build Options
thopt,quasi,5.e-002
nlhist,nsol,MAX_TEMP,temp,max
nlhist,nsol,MIN_TEMP,temp,min
/com,********* Initial Time Increment Check And Fourier Modulus *********
/com, Specified Initial Time Increment: 0.01 
/com, Estimated Increment Needed, le*le/alpha, Body 1: 0.0262023 
/com, Estimated Increment Needed, le*le/alpha, Body 2: 0.0262023 
/com, Estimated Increment Needed, le*le/alpha, Body 3: 0.0140781 
/com,****************************************************
/com,******************* SOLVE FOR LS 1 OF 2 ****************
d,_CM81,temp,80.
/nopr
/gopr
outres,erase
outres,all,none
outres,nsol,all
outres,rsol,all
amres,dtemp,on
cnvtol,heat,,1.e-003,,1.e-006 ! Program Controlled. Set MINREF equivalent of 1e-6 Watts
/com,*********** Send AM Build Conditions Options ***********
amenv,120.,0.       ! Gas Temperature and Convection Coefficient
ampowder,120.,0.,1.e-002      ! Powder Temperature, Convection Coefficient, and factor
! *********** WB SOLVE COMMAND ***********
! check interactive state
*get,ANSINTER_,active,,int
*if,ANSINTER_,ne,0,then
/eof
*endif
amstep,build,,,,    ! perform the layer-by-layer build
/com *************** Write FE CONNECTORS ********* 
CEWRITE,file,ce,,INTE
/com,****************************************************
/com,*************** FINISHED SOLVE FOR LS 1 *************
/com,****************************************************
/com,******************* SOLVE FOR LS 2 OF 2 ****************
/nopr
/gopr
outres,erase
outres,all,none
outres,nsol,all
outres,rsol,all
amres,dtemp,on
cnvtol,heat,,1.e-003,,1.e-006 ! Program Controlled. Set MINREF equivalent of 1e-6 Watts
/com,*********** Send AM Cooldown Conditions Options ***********
amenv,22.,20.       ! Gas Temperature and Convection Coefficient
ampowder,22.,5.,1.e-002       ! Powder Temperature, Convection Coefficient
amstep,cooldown,22. ! cool down to room temperature
/com,****************************************************
/com,*************** FINISHED SOLVE FOR LS 2 *************
*get,_wallasol,active,,time,wall
/post1
xmlo,ENCODING,ISO-8859-1
xmlo,parm
/xml,parm,xml
fini
/gopr
*get,_walldone,active,,time,wall
_preptime=(_wallbsol-_wallstrt)*3600
_solvtime=(_wallasol-_wallbsol)*3600
_posttime=(_walldone-_wallasol)*3600
_totaltim=(_walldone-_wallstrt)*3600
*get,_dlbratio,active,0,solu,dlbr
*get,_combtime,active,0,solu,comb
*get,_ssmode,active,0,solu,ssmm
*get,_ndofs,active,0,solu,ndof
/fclean				!clean distributed files
/com,--- Total number of nodes = %_numnode%
/com,--- Total number of elements = %_numelem%
/com,--- Element load balance ratio = %_dlbratio%
/com,--- Time to combine distributed files = %_combtime%
/com,--- Sparse memory mode = %_ssmode%
/com,--- Number of DOF = %_ndofs%
/wb,file,end               ! done with WB generated input
